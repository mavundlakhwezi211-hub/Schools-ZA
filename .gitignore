.env
.env.*
!.env.example
firebase-adminsdk*.json
service-account*.json

# A real Labs token pasted into env.js is a browser-visible secret.
# Keep any such file out of version control (or use env.local.js instead).
env.js
env.local.js
# Build artefacts from tools/fetch-schools.php (recreate with the tool).
tools/schools-cache.jsonl
tools/schools-progress.json
tools/fetch-log.txt
tools/fetch-error.txt

# Composer dependencies (recreate with: composer install).
# vendor/ is generated; composer.lock IS committed so installs are reproducible.
vendor/
